COMPOSE_PROJECT_NAME=bankapp

# Required — choose a strong password for the Postgres role.
POSTGRES_PASSWORD=change_me

# Required — used to encrypt backups at rest (AES-256-GCM). Must be exactly 64 hex
# characters (32 bytes), and must NOT be the same key used in any other
# environment (dev/prod keys should never be shared). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Comma-separated list of every origin (scheme + host + port) you actually access
# the app from — e.g. your LAN IP and/or public domain once configured.
CORS_ORIGINS=http://localhost:5173
# Username promoted to admin at startup if the database has no admin yet. Leave empty to skip.
BOOTSTRAP_ADMIN_USERNAME=
# Development only: create an 'admin' user with password 'admin' when the database has no users.
# Never set this in production.
SEED_DEV_ADMIN=false

# Host path used to resolve the backup volume mount.
BACKUP_DIR=./backups

DATABASE_URL=postgresql://bankapp:change_me@postgres:5432/bankapp

# Deployment names and ports (defaults = BankApp). Set your own values if you run a second
# instance on the same host so nothing is shared.
# Create the external volume and network by hand before the first start.
CONTAINER_PREFIX=bankapp
API_PORT=3000
WEB_PORT=5173
DB_PORT=5433
PGDATA_VOLUME=bankapp-pgdata
NETWORK_NAME=bankapp-net
# Commit shown in the About dialog (set it to `git rev-parse --short HEAD` when deploying).
# GIT_COMMIT=dev
