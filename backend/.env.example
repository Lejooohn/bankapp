# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bankapp

# Auth (optionnel)
AUTH_TOKEN=

# Chiffrement des sauvegardes
# Générer une clé: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Sauts de proxy de confiance devant l'API. 1 = le proxy nginx du frontend, qui écrase X-Forwarded-For
# avec l'adresse réelle du client. Ne pas changer sans vérifier la chaîne sur le NAS.
# TRUST_PROXY_HOPS=1

# Plage IP du reverse proxy DSM, dont le X-Forwarded-For est pris en compte par nginx (docker-compose.yml).
# TRUSTED_PROXY_CIDR=172.16.0.0/12
