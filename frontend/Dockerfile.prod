# Production image: builds the SPA with `vite build` and serves it with nginx.
# Dev stays in ./Dockerfile (Vite dev server with HMR), which docker-compose uses.
#   docker build -f frontend/Dockerfile.prod -t bankapp-web:prod .  (from the repository root)

FROM node:26-alpine AS build

WORKDIR /app

COPY shared/package*.json ./shared/
RUN cd shared && npm ci
COPY shared/ ./shared/
RUN cd shared && npm run build

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:stable-alpine

COPY frontend/deploy/default.conf.template /etc/nginx/templates/default.conf.template
COPY frontend/deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

# Plage IP des proxys de confiance (le DSM). Seule cette variable est substituée dans le modèle.
ENV TRUSTED_PROXY_CIDR=172.16.0.0/12 \
    NGINX_ENVSUBST_FILTER=^TRUSTED_PROXY_CIDR$
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1
