# Production static server for the BankApp frontend (template: the nginx image renders
# ${TRUSTED_PROXY_CIDR} from the environment at start-up, see NGINX_ENVSUBST_FILTER).
# /api is proxied to the backend service; everything else is the built SPA.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # Behind the DSM reverse proxy, DSM connects from TRUSTED_PROXY_CIDR and sends the real
  # client address in X-Forwarded-For. Only then is that address taken as the client.
  # Connections from anywhere else keep their socket address (no header is trusted).
  set_real_ip_from ${TRUSTED_PROXY_CIDR};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # Transaction imports (CSV) and backup restores can be large (backend accepts 50 MB).
  client_max_body_size 60m;

  # Hashed build assets can be cached forever; index.html must always be revalidated.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location /api/ {
    # The API already sends its own security headers; they are not repeated here.
    # Resolve "backend" at request time (Docker's embedded DNS), not once at startup:
    # a recreated backend container gets a new IP and nginx would otherwise keep the old one.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream http://backend:3000;
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite, never append: the backend trusts exactly one hop (this proxy), so the
    # header must hold the client address alone, not a chain a client could extend.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Server-sent events (/api/events) must not be buffered.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
